class Solution {
    public int[] sortedSquares(int[] nums) {
        int[] result=new int[nums.length];
        int l=0,r=nums.length-1,i=nums.length-1;
        while(l<=r){
            if(Math.abs(nums[l])>Math.abs(nums[r])){
                result[i]=nums[l]*nums[l];
                l++;
                i--;
            }
            else{
                result[i]=nums[r]*nums[r];
                r--;
                i--;
            }
        }

    return result;  
    }
}
